#!/usr/bin/env python3
"""Start a named engineering or review role locally or in an Orca terminal."""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
from task_session import launch_task, review_result
from role_launch import launch_spec, EFFORT
from role_contract import orca_command, local_orca_only, workspace_root, role_routing, home_role, role_label, resolve_role


def project_request(role, args, parser):
    if args.interactive or args.batch_worker or args.cwd:
        parser.error('--repo は依頼を受領する入口。interactive / batch-worker / cwd とは併用しない')
    from project_tasks import request_plan, dispatch
    try:
        local_orca_only()
        existing = None
        if args.worktree:
            if not args.worktree.startswith('path:') or not Path(args.worktree[5:]).is_absolute():
                raise ValueError('--worktree は再利用する path:<絶対パス> を指定する')
            existing = Path(args.worktree[5:]).resolve()
        if args.read_only and args.access == 'edit':
            raise ValueError('--read-only と編集依頼は併用しない')
        plan = request_plan(role, args.repo, args.prompt,
                            access=args.access or ('read' if args.read_only else None),
                            base_ref=args.base_ref, task_id=args.task_id, origin=args.from_role,
                            model=args.model, effort=args.effort, workspace=existing, dry_run=args.dry_run,
                            worker_backend=args.worker_backend, expected_sha=args.expected_sha,
                            development=args.development)
        if args.dry_run:
            print(json.dumps(plan, ensure_ascii=False, indent=2))
            return 0
        orca = orca_command()
        if not shutil.which(orca):
            raise ValueError('Orca CLI が見つからない: ' + orca)
        return dispatch(orca, plan, args.prompt, model=args.model, effort=args.effort, metadata=args.json)
    except (ValueError, OSError, RuntimeError) as exc:
        parser.error(str(exc))


def main():
    alias = resolve_role(Path(sys.argv[0]).name)
    parser = argparse.ArgumentParser(description='名前付き役割を一件ごとの Orca タスク、または明示した対話セッションで起動')
    if alias not in EFFORT:
        parser.add_argument('role', type=resolve_role, choices=sorted(EFFORT))
    parser.add_argument('--cwd', help='対象 workspace（既定は現在の場所、または --worktree の path）')
    parser.add_argument('--repo', type=Path, help='共通手順で案件を受領。編集依頼は案件用 worktree を作る')
    parser.add_argument('--access', choices=('read', 'edit'), help='案件の読み取り/編集。既定は役の責任に従う')
    parser.add_argument('--base-ref', help='新規案件用 worktree の明示 base。省略時は Orca repo の既定')
    parser.add_argument('--task-id', help='repo 内の依頼 ID。同じ ID の依頼は再実行しない')
    parser.add_argument('--from-role', type=resolve_role, choices=('owner', 'tomato', 'banana', 'review'), default='owner', help='依頼元の記録。追加の承認ではない')
    parser.add_argument('--worker-backend', choices=('codex', 'devin'), default='codex', help=argparse.SUPPRESS)
    parser.add_argument('--development', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--expected-sha', help='読み取り案件の固定 full HEAD SHA')
    parser.add_argument('--read-only', action='store_true', help='今回の実行を読み取り専用に制限する')
    parser.add_argument('--model', help='今回の明示モデル指定。省略時は各 profile の既定')
    parser.add_argument('--effort', choices=('low', 'medium', 'high', 'xhigh', 'max', 'ultra'))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--exec', action='store_true', dest='batch', help='タスク用の Orca タブで実行し、結果保存後に閉じる（--task と同じ）')
    mode.add_argument('--task', action='store_true', help='タスクごとに Orca タブを新設し、終了後に閉じる')
    mode.add_argument('--batch-worker', action='store_true', help=argparse.SUPPRESS)
    mode.add_argument('--orca', action='store_true', help='Orca に名前付き terminal を作って起動')
    parser.add_argument('--interactive', action='store_true', help='手動の対話セッション。タスクの自動終了を使わない')
    parser.add_argument('--worktree', help='Orca の対象 path:<絶対パス>（省略時は役ごとの作業場所）')
    parser.add_argument('--dry-run', action='store_true', help='起動引数を JSON で確認。セッションを起動しない')
    parser.add_argument('--json', action='store_true', help='保存した案件の結果 metadata を返す')
    parser.add_argument('--prompt-file', type=Path, help='UTF-8 の依頼ファイルをそのまま渡す。位置引数の依頼とは併用不可')
    parser.add_argument('prompt', nargs='?', help='今回の依頼（空白を含む場合は引用符で囲む）')
    args = parser.parse_intermixed_args()
    if args.prompt_file is not None:
        if args.prompt is not None:
            parser.error('--prompt-file と位置引数の依頼は併用しない')
        try:
            args.prompt = args.prompt_file.expanduser().read_text(encoding='utf-8')
        except (OSError, UnicodeError) as exc:
            parser.error('依頼ファイルを読めない: ' + str(exc))
        if not args.prompt.strip():
            parser.error('依頼ファイルが空')
    role = alias if alias in EFFORT else args.role
    task = args.task or args.batch or (args.prompt is not None and not args.interactive and not args.batch_worker)
    batch = task or args.batch_worker
    if args.interactive and (args.task or args.batch or args.batch_worker):
        parser.error('--interactive とタスク実行は同時に指定しない')
    if args.json and not task:
        parser.error('--json は Orca タスク実行と一緒に指定する')
    if args.repo:
        return project_request(role, args, parser)
    if args.access or args.base_ref or args.task_id or args.from_role != 'owner' or args.expected_sha or args.worker_backend != 'codex' or args.development:
        parser.error('案件の access / base-ref / task-id / from-role は --repo と一緒に指定する')
    if args.worktree and not (args.orca or task):
        parser.error('--worktree は Orca 実行と一緒に指定する')
    worktree_path = None
    if args.worktree:
        if not args.worktree.startswith('path:') or not args.worktree[5:]:
            parser.error('--worktree は対象を固定する path:<絶対パス> を指定する')
        worktree_path = Path(args.worktree[5:]).expanduser()
        if not worktree_path.is_absolute():
            parser.error('--worktree の path は絶対パスを指定する')
        worktree_path = worktree_path.resolve()
    cwd = Path(args.cwd).expanduser().resolve() if args.cwd else worktree_path or Path.cwd().resolve()
    if worktree_path and cwd != worktree_path:
        parser.error('--cwd と --worktree の対象 path が一致しない')
    if not cwd.is_dir():
        parser.error('workspace が存在しない: ' + str(cwd))
    if batch and (not args.prompt or not args.prompt.strip()):
        parser.error('タスク実行には今回の依頼が必要')
    try:
        spec = launch_spec(role, cwd, args.prompt, model=args.model, effort=args.effort,
                           batch=batch, dry_run=args.dry_run, read_only=args.read_only)
    except ValueError as exc:
        parser.error(str(exc))
    command, environment = spec['command'], spec['environment']
    backend, skill, installed, effort = spec['backend'], spec['skill'], spec['profile'], spec['effort']
    if args.orca or task:
        try:
            local_orca_only()
        except ValueError as exc:
            parser.error(str(exc))
        orca = orca_command()
        if not shutil.which(orca) and not args.dry_run:
            parser.error('Orca CLI が見つからない: ' + orca)
    if args.orca and not task:
        # Pin validated config and effort even when Orca starts a fresh shell.
        terminal_command = ['/usr/bin/env'] + [key + '=' + value for key, value in environment.items()] + command
        # Orca's terminal process may start outside the selected worktree.
        terminal_command = ['/bin/sh', '-c', 'cd ' + shlex.quote(str(cwd)) + ' && exec ' + shlex.join(terminal_command)]
        launch = [orca, 'terminal', 'create', '--worktree', 'path:' + str(cwd),
                  '--title', role_label(role), '--command', shlex.join(terminal_command), '--json']
    else:
        launch = command
    if args.dry_run:
        print(json.dumps({'role': role, 'displayName': role_label(role), 'cwd': str(cwd),
                          'roleRouting': role_routing(role),
                          'profile': str(installed), 'skill': str(skill), 'backend': backend,
                          'requestedModel': spec['requestedModel'],
                          'requestedEffort': effort, 'mode': 'task' if task else 'orca' if args.orca else 'exec' if batch else 'interactive',
                          'taskWorkspace': 'path:' + str(worktree_path) if worktree_path else None,
                          'roleWorkspaceRoot': str(workspace_root(home_role(role))),
                          'visible': task, 'closeAfterResult': task,
                          'argv': launch, 'startsSession': False}, ensure_ascii=False, indent=2))
        return 0
    try:
        if task:
            return launch_task(role, command, cwd, environment, orca, args.json,
                               'path:' + str(worktree_path) if worktree_path else None,
                               collector=spec['collector'])
        if args.orca:
            # The receipt proves terminal creation; it does not assert task completion.
            return subprocess.run(launch, cwd=str(cwd)).returncode
        os.chdir(cwd)
        child_env = os.environ.copy()
        child_env.update(environment)
        if batch and spec['collector'] == 'claude':
            # Internal batch callers receive only results from the pinned model.
            completed = subprocess.run(command, cwd=cwd, env=child_env, text=True, capture_output=True)
            if completed.returncode:
                print(completed.stderr, file=sys.stderr, end='')
                return completed.returncode
            try:
                verified = review_result(completed.stdout)
            except (ValueError, TypeError) as exc:
                print('Potato: BLOCKED — ' + str(exc), file=sys.stderr)
                return 3
            verified = dict(verified, role='review', backend='claude', requestedModel='claude-opus-5-5',
                            actualModel=next(iter(verified['modelUsage'])), isFinalVerdict=False)
            print(json.dumps(verified, ensure_ascii=False))
            return 0
        os.execvpe(command[0], command, child_env)
    except (OSError, RuntimeError, ValueError, KeyError) as exc:
        print('起動できない: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
