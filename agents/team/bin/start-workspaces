#!/usr/bin/env python3
"""Check existing named Orca homes and optionally install their command links."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from role_contract import NAMES, ROLES, HOME_ROLES, home_role, orca_command, local_orca_only, find_workspace, workspace_root, role_routing, resolve_role, role_label


def call(*args):
    result = subprocess.run([orca_command(), *args, '--json'], text=True, capture_output=True, check=True)
    data = json.loads(result.stdout)
    if data.get('ok') is not True:
        raise RuntimeError(result.stdout)
    return data['result']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('role', nargs='?', type=resolve_role, choices=NAMES)
    parser.add_argument('--check', action='store_true', help='Read-only home and coordination check')
    args = parser.parse_args()
    local_orca_only()
    roles = [args.role] if args.role else list(HOME_ROLES)
    # Resolve only the permanent entries. Missing/ambiguous entries must
    # never create another card; specialists do not require retired homes.
    snapshot = call('worktree', 'list')
    targets = {role: find_workspace(home_role(role), snapshot) for role in roles}
    parents = {role: find_workspace(ROLES[role]['parentRole'], snapshot)['id']
               if ROLES[role]['parentRole'] else None
               for role in roles if 'parentRole' in ROLES[role]}
    # Permanent domain entries are independent. Setup manages metadata for
    # those entries separately from each project's development/review lineage.
    if not args.check:
        subprocess.run([sys.executable, str(ROOT / 'bin/setup')], check=True)
    for role, target in targets.items():
        wid = target['id']
        permanent = role in HOME_ROLES
        terminals = call('terminal', 'list', '--worktree', 'id:' + wid)['terminals'] if permanent else []
        # Task sessions are created by the role launcher and closed after result collection.
        # Idle agents make workspace cards look active without any assigned task.
        print(json.dumps({'role': role, 'displayName': role_label(role), 'workspace': target['displayName'], 'state': 'ready' if permanent else 'on-demand',
                          'workspaceRoot': str(workspace_root(home_role(role))),
                          'workspacePurpose': 'role-home' if permanent else 'task-specialist',
                          **role_routing(role), 'coordinatorWorktreeId': parents.get(role),
                          'orcaParentWorktreeId': target.get('parentWorktreeId'),
                          'handles': [t['handle'] for t in terminals],
                          'worktreeId': wid}, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (subprocess.CalledProcessError, RuntimeError, KeyError, ValueError, OSError) as exc:
        print('Workspace startup blocked: ' + str(exc), file=sys.stderr)
        raise SystemExit(1)
