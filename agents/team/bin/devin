#!/usr/bin/env python3
"""Coordinate an external Devin worker and the Orca quality gate."""
import argparse
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from devin_flow import Blocked, UNCONFIRMED_STATES, config, run


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('action', choices=('start', 'sync', 'status', 'reconcile'))
    parser.add_argument('--issue', required=True)
    parser.add_argument('--config', type=Path, default=os.environ.get('NAMED_TEAM_DEVIN_CONFIG', ROOT / 'config/devin.json'))
    parser.add_argument('--state-root', type=Path, default=os.environ.get('NAMED_TEAM_DEVIN_STATE_DIR', Path.home() / '.local/share/named-team/devin'))
    args = parser.parse_args()
    try:
        cfg = config(args.config, connected=args.action != 'status')
        record = run(cfg, args.state_root, args.issue, args.action)
        print(json.dumps(record, ensure_ascii=False, indent=2))
        if args.action != 'status' and record['state'] in UNCONFIRMED_STATES:
            return 3
        return 0
    except (Blocked, OSError, ValueError, KeyError, TypeError):
        # Do not leak adapter stdout/stderr, authentication values or ticket bodies.
        print('Devin flow blocked or unconfirmed. Check configuration / preserved execution record.', file=sys.stderr)
        return 3


if __name__ == '__main__':
    raise SystemExit(main())
