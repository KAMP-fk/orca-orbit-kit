#!/usr/bin/env python3
"""One explicit review or communication request; no automatic model startup."""
import argparse
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from review_routing import review_plan
from role_contract import local_orca_only
from potato_communication import communication_plan
from team_mail import default_root, records


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('--inbox', action='store_true', help='モデル無しで受付方法と未返答の連絡を表示')
    parser.add_argument('--kind', choices=('acceptance', 'technical', 'final', 'communication'))
    parser.add_argument('--id', help='communication の元の連絡 ID')
    parser.add_argument('--mail-root', type=Path, default=default_root(), help='通常は省略。fixture 用の別受信箱')
    parser.add_argument('--repo', type=Path)
    parser.add_argument('--issue')
    parser.add_argument('--pr')
    parser.add_argument('--sha', help='対象 checkout の現在の full HEAD SHA')
    parser.add_argument('--prompt-file', type=Path)
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    if args.inbox:
        if any((args.kind, args.repo, args.issue, args.pr, args.sha, args.prompt_file, args.id)):
            parser.error('--inbox と依頼は併用しない')
        print('Potato｜受入・技術レビュー — Opus 5.5 / high 固定\n'
              '受入確認: potato --kind acceptance --repo <checkout> --issue <ID>\n'
              '技術確認: potato --kind technical --repo <checkout> --prompt-file <依頼>\n'
              '最終判定: potato --kind final --repo <checkout> --sha <full HEAD SHA> --dry-run\n'
              '連絡への返答: potato --kind communication --id <message-ID>（--dry-run で起動前確認）\n'
              '依頼がある時だけ実行。最終判定と concafe のレビューは未関与の別タスクへ引渡し。別モデルへ fallback しない。\n'
              '連絡: 共通受信箱の自分宛を読む。返答・記録は Banana が原文中継し、Tomato が Sol で日報・日誌へ集約。')
        try:
            pending = records(args.mail_root, 'potato', unread=True)
            print('\n未受領・未返答の連絡: ' + str(len(pending)) + '件')
            for item in pending:
                state = '返答待ち' if item.get('needs_reply', True) else '受領待ち'
                print(item['id'] + ' | ' + item['from'] + ' | ' + state + ' | '
                      + json.dumps(item['subject'], ensure_ascii=False))
        except (OSError, ValueError, KeyError) as exc:
            parser.error(str(exc))
        return 0
    if args.kind == 'communication':
        if not args.id or any((args.repo, args.issue, args.pr, args.sha, args.prompt_file)):
            parser.error('communication は --id で1件を指定する。レビューの引数とは併用しない')
        try:
            local_orca_only()
            plan = communication_plan(args.mail_root, args.id)
            if args.dry_run:
                print(json.dumps(plan, ensure_ascii=False, indent=2))
                return 0
            os.execv(sys.executable, plan['argv'])
        except (OSError, ValueError, RuntimeError, KeyError) as exc:
            parser.error(str(exc))
    if args.id:
        parser.error('--id は --kind communication 専用')
    if not args.kind or not args.repo:
        parser.error('--kind と --repo に依頼種別・対象 checkout を指定する')
    try:
        local_orca_only()
        plan = review_plan(args.kind, args.repo, args.issue, args.pr, args.prompt_file, args.sha)
        if args.dry_run or not plan['executableHere']:
            print(json.dumps(plan, ensure_ascii=False, indent=2))
            return 0 if args.dry_run else 3  # Handoff required, never completed/PASS.
        os.execv(sys.executable, plan['argv'])
    except (OSError, ValueError, RuntimeError) as exc:
        parser.error(str(exc))


if __name__ == '__main__':
    raise SystemExit(main())
