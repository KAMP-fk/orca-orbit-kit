#!/usr/bin/env python3
"""Observe one local Git checkout and contract paths without changing it."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from checkout_context import observe


def main():
    parser = argparse.ArgumentParser(description='ローカル checkout 確認（変更・fetch・承認判定なし）')
    parser.add_argument('repo', nargs='?', default='.', help='対象 checkout のパス')
    parser.add_argument('--card', help='状況カードのパス（任意）')
    parser.add_argument('--json', action='store_true', help='観測をJSONで表示')
    args = parser.parse_args()
    result = observe(Path(args.repo).expanduser().resolve(),
                     Path(args.card).expanduser().resolve() if args.card else None)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print('確認: ' + result['observedAt'] + ' / ' + result['status'])
        if result['status'] == 'complete':
            print('Checkout: ' + result['repositoryRoot'])
            print('Branch: ' + (result['branch'] or '(detached)'))
            print('Full SHA: ' + result['headSha'])
            print('未コミット変更: ' + ('あり' if result['dirty'] else 'なし'))
            for item in result['contractSources']:
                print(('あり: ' if item['present'] else '未検出: ') + item['path'])
            if 'statusCard' in result:
                card = result['statusCard']
                print('状況カード: ' + card['path'] + (' / ' + str(card['lineCount']) + '行' if card['present'] else ' / 未検出'))
            print('リモート最新状態・規約本文・着手権限は未確認')
        else:
            print(result['error'], file=sys.stderr)
    return 0 if result['status'] == 'complete' else 1


if __name__ == '__main__':
    raise SystemExit(main())
