#!/usr/bin/env python3
"""Install owned links and expose read-only activity in existing Orca homes."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from role_contract import local_orca_only, orca_command
import workspace_display


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('--check', action='store_true', help='Check links and display plan without mutations')
    parser.add_argument('--home', type=Path, help='Isolated installation; does not access live Orca')
    args = parser.parse_args()
    local_orca_only()
    isolated = args.home is not None
    if isolated and args.home.expanduser().resolve() == Path.home().resolve():
        parser.error('--home must be isolated; omit it for live setup')
    # Validate executables and all display targets before installing any links.
    if not isolated:
        for executable in ('codex', orca_command()):
            if not shutil.which(executable):
                raise RuntimeError('Missing executable: ' + executable)
        targets, existing = workspace_display.prepare()
    installer = [sys.executable, str(ROOT / 'install.py')]
    if isolated:
        installer += ['--home', str(args.home)]
    if not args.check:
        subprocess.run(installer, check=True)
    checked = subprocess.run([*installer, '--check'], check=False)
    if args.check or checked.returncode:
        if not isolated:
            print(json.dumps({'displayChanges': [row['title'] for row in targets if row['changed']],
                              'activityTerminal': existing['handle'] if existing else 'missing'}, ensure_ascii=False))
        return checked.returncode or (0 if isolated or (existing and not any(row['changed'] for row in targets)) else 1)
    if not isolated:
        handle = workspace_display.apply(targets, existing)
        workspace_display.verify(targets, workspace_display.call('worktree', 'list', '--limit', '1000'))
        workspace_display.confirm(handle)
        print(json.dumps({'activityTerminal': handle, 'state': 'read-only observer'}, ensure_ascii=False))
    print('Setup ready: owned links installed. Devin connection and observed activity are shown in Activity; no agent was launched.')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError):
        print('Setup blocked or unconfirmed. Existing sessions retained; inspect before retry.', file=sys.stderr)
        raise SystemExit(1)
