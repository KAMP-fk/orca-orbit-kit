#!/usr/bin/env bash
# Shared entry-point/library globals are consumed across sourced modules.
# shellcheck disable=SC2034
# Peach (legacy executable name: linear-inreview-reviewer)
#
# Linear の status が厳密に "In Review" の Issue を対象に、
# 外部到達（Linear / GitHub）を「起動側」で済ませたレビューパケットを作り、
# read-only に制限したレビュアー Agent を、固定モデルで起動する。
#
# この Agent は Reviewer であり、実装・マージ・Linear 更新を一切行わない。
#
# 受入 pipeline の正本プロトコル: ../skill/SKILL.md。公開入口は review --kind acceptance
set -euo pipefail

# git -C does not override GIT_DIR/GIT_WORK_TREE/index/object/config redirections.
# Launcher-owned clones must not inherit a different repository's Git context.
while IFS= read -r git_environment_name; do
  case "$git_environment_name" in GIT_*) unset "$git_environment_name" ;; esac
done < <(compgen -e)
export GIT_TERMINAL_PROMPT=0

REVIEWER_NAME="peach"
REQUIRED_STATE="In Review"

# このスクリプトの実体（~/.local/bin のシンボリックリンク経由でも）から root を決める。
# エージェント一式は1つのフォルダに収まっており、外の固定パスに依存しない。
_self="$0"
if command -v python3 >/dev/null 2>&1; then
  _self="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
else
  while [ -L "$_self" ]; do
    _link="$(readlink "$_self")"
    case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
  done
fi
AGENT_ROOT="${LINEAR_INREVIEW_ROOT:-$(cd "$(dirname "$_self")/.." && pwd)}"

PROTOCOL="${LINEAR_INREVIEW_PROTOCOL:-$AGENT_ROOT/skill/SKILL.md}"
STATE_HOME="${LINEAR_INREVIEW_HOME:-$AGENT_ROOT/state}"
CLAUDE_SETTINGS="${LINEAR_INREVIEW_CLAUDE_SETTINGS:-$AGENT_ROOT/claude/settings.json}"

# --- 承認モデル（モデルと effort は全パスで固定） ----------------------------
CODEX_MODEL="gpt-5.6-sol"
CODEX_EFFORT="high"
CLAUDE_MODEL="claude-opus-5-5"
CLAUDE_EFFORT="high"
MAX_PR_CANDIDATES=3

LEDGER="${STATE_HOME}/ledger.tsv"
START_EPOCH="$(date +%s)"

BACKEND="claude"
ISSUE=""
EXPLICIT_PRS=()
EXPLICIT_RUNS=()
EXPLICIT_TEST_CHECKS=()
DRAFT_LIGHT_CI=0
DO_LIST=0
PACKET_ONLY=0
PREFLIGHT=1

# Library location follows this executable, even when AGENT_ROOT is overridden.
LIB_ROOT="$(cd "$(dirname "$_self")/../lib" && pwd)"
# Keep the existing pipeline/legacy entry intact; opt into Orca's visible lifecycle.
for peach_option in "$@"; do
  case "$peach_option" in
    --orca|--task|--dry-run)
      exec python3 "$LIB_ROOT/../../../../bin/acceptance-task" "$@"
      ;;
  esac
done

if [ -n "${ORCA_CLI_COMMAND:-}" ]; then
  ORCA_BIN="$ORCA_CLI_COMMAND"
elif [ -n "${ORCA_DEV_REPO_ROOT:-}" ]; then
  ORCA_BIN="orca-dev"
elif [ "$(uname -s)" = Linux ]; then
  ORCA_BIN="orca-ide"
else
  ORCA_BIN="orca"
fi
for module in report cli evidence linear github packet backend; do
  # shellcheck source=/dev/null
  source "$LIB_ROOT/$module.sh"
done

parse_args "$@"
REVIEW_MODE=issue
if [ "${#EXPLICIT_PRS[@]}" -gt 0 ]; then
  REVIEW_MODE=fixed-pr
fi
[ "$BACKEND" = claude ] || die 'Potato は Claude Opus 5.5 / high に固定。別 backend は起動しない'
for bin in "$ORCA_BIN" gh jq git python3; do
  command -v "$bin" >/dev/null 2>&1 || die "required command not found: $bin"
done
[ -r "$PROTOCOL" ] || die "protocol not readable: $PROTOCOL"

if [ "$DO_LIST" = 1 ]; then
  "$ORCA_BIN" linear list-issues --state "$REQUIRED_STATE" --json \
    | jq -r --arg s "$REQUIRED_STATE" '
        .result.issues[] | select(.state.name == $s)
        | "\(.identifier)\t\(.team.key)\t\(.state.name)\t\(.title)"' \
    | { column -t -s "$(printf '\t')" 2>/dev/null || cat; }
  exit 0
fi
[ -n "$ISSUE" ] || { usage >&2; exit 2; }

if [ "$PACKET_ONLY" != 1 ]; then
  command -v "$BACKEND" >/dev/null 2>&1 \
    || blocked "実行バックエンド '${BACKEND}' の CLI がこのホストに無い。承認モデルを利用できないため停止した。"
  [ "$BACKEND" != "claude" ] || claude_settings_preflight
fi

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
SAFE_ISSUE="$(printf '%s' "$ISSUE" | tr -c 'A-Za-z0-9._-' '_')"
mkdir -p "$STATE_HOME/packets/$SAFE_ISSUE"
PACKET="$(mktemp -d "$STATE_HOME/packets/$SAFE_ISSUE/$STAMP.XXXXXX")"
mkdir -p "$PACKET/linear/related" "$PACKET/github"
init_evidence

fetch_linear
collect_candidates
fetch_github
write_packet
if [ "$PACKET_ONLY" = 1 ]; then
  printf '%s\n' "$PACKET"
  exit 0
fi
assert_evidence_ready
preflight_backend
launch_reviewer
record_verdict
exit "$RC"
