#!/usr/bin/env python3
"""Start conversation entries or a model-free Review inbox in existing homes."""
import argparse
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from role_contract import ROLES, local_orca_only, workspace_root


def selected_role():
    env = os.environ
    if env.get('TERM_PROGRAM') != 'Orca' or not env.get('ORCA_TERMINAL_HANDLE', '').startswith('term_'):
        return None
    local_orca_only()
    cwd = Path.cwd().resolve()
    worktree = env.get('ORCA_WORKTREE_ID', '')
    if '::' not in worktree or worktree.rsplit('::', 1)[1] != str(cwd):
        return None
    matches = [role for role in ROLES if ROLES[role]['tabAutostart'] and workspace_root(role).resolve() == cwd]
    if len(matches) > 1:
        raise ValueError('担当ホームが重複しているため自動起動を中止')
    return matches[0] if matches else None


def main():
    parser = argparse.ArgumentParser(description='新規タブで Tomato/Banana の対話または Review のモデル無し受付を開始')
    parser.add_argument('--resolve', action='store_true', help='該当する role 名だけを返す。モデルは起動しない')
    args = parser.parse_args()
    try:
        role = selected_role()
        if not role:
            return 0
        if args.resolve:
            print(role)
            return 0
        if role == 'peach':
            command = [sys.executable, str(ROOT / 'bin/review'), '--inbox']
        else:
            print(role.capitalize() + ' の対話セッションを起動します。', flush=True)
            command = [sys.executable, str(ROOT / 'bin/agent'), role, '--interactive', '--cwd', str(Path.cwd())]
        os.execvpe(command[0], command, os.environ.copy())
    except (OSError, ValueError, KeyError) as exc:
        print('新規タブの自動起動を中止: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
