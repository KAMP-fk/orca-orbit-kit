#!/usr/bin/env python3
"""Ensure named Orca workspace cards exist; launch sessions only for real tasks."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
from role_contract import NAMES, ROLES, orca_command, local_orca_only, find_workspace, workspace_root, role_routing

FOLDER = Path.home() / '.agents/skills'


def call(*args):
    result = subprocess.run([orca_command(), *args, '--json'], text=True, capture_output=True, check=True)
    data = json.loads(result.stdout)
    if data.get('ok') is not True:
        raise RuntimeError(result.stdout)
    return data['result']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('role', nargs='?', choices=NAMES)
    parser.add_argument('--check', action='store_true', help='Read-only home and coordination check')
    args = parser.parse_args()
    local_orca_only()
    roles = [args.role] if args.role else list(NAMES)
    # Inventory all projects before mutation: Tomato/Banana already live in brain,
    # and Peach already has its own project. A renamed title is not a new role.
    snapshot = call('worktree', 'list')
    targets = {role: find_workspace(role, snapshot, required=False) for role in roles}
    for role, target in targets.items():
        if target is None and (args.check or workspace_root(role) != FOLDER):
            raise RuntimeError('Missing role home: ' + role + ' at ' + str(workspace_root(role)))
    parents = {role: find_workspace(ROLES[role]['parentRole'], snapshot)['id']
               if ROLES[role]['parentRole'] else None
               for role in roles if 'parentRole' in ROLES[role]}
    # Role supervision spans projects. Orca's Git lineage cannot cross that boundary.
    # Record the coordinator home without changing native parentWorktreeId metadata.
    if not args.check:
        subprocess.run([sys.executable, str(ROOT / 'bin/setup')], check=True)
    repo = None
    for role, target in targets.items():
        if target is None:
            if repo is None:
                repos = [r for r in call('repo', 'list')['repos'] if r['path'] == str(FOLDER)]
                if len(repos) > 1:
                    raise RuntimeError('Ambiguous agent project; no changes made')
                repo = repos[0]['id'] if repos else call('repo', 'add', '--path', str(FOLDER))['repo']['id']
            target = call('worktree', 'create', '--repo', 'id:' + repo,
                          '--name', NAMES[role], '--no-parent', '--setup', 'skip')['worktree']
        wid = target['id']
        terminals = call('terminal', 'list', '--worktree', 'id:' + wid)['terminals']
        # Task sessions are created by the role launcher and closed after result collection.
        # Idle agents make workspace cards look active without any assigned task.
        print(json.dumps({'role': role, 'workspace': target['displayName'], 'state': 'ready',
                          **role_routing(role), 'coordinatorWorktreeId': parents.get(role),
                          'orcaParentWorktreeId': target.get('parentWorktreeId'),
                          'handles': [t['handle'] for t in terminals],
                          'worktreeId': wid}, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (subprocess.CalledProcessError, RuntimeError, KeyError, ValueError, OSError) as exc:
        print('Workspace startup blocked: ' + str(exc), file=sys.stderr)
        raise SystemExit(1)
