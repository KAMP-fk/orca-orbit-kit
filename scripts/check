#!/usr/bin/env bash
# Check sources and index without starting agents or changing the running service.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/agents/team/bin/check"
pnpm --dir "$root/apps/orbit" check
python3 "$root/scripts/scan-source.py" --repo "$root"
python3 "$root/scripts/scan-source.py" --repo "$root/apps/orbit"
python3 "$root/scripts/scan-source.py" --repo "$root/agents/team/roles/tomato/skill"
