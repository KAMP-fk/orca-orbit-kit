# Optional commands and workspace configuration; keep the real host.env outside Git.
# Existing role workspace roots default to ~/orca/workspaces/brain/{Tomato,Banana}.
ORCA_CLI_COMMAND=orca
# Tomato's read-only project observation; values apply only when exported.
TOMATO_REPO=owner/project
TOMATO_WORK=/absolute/path/to/project
TOMATO_BRAIN=/absolute/path/to/private/vault
# Store observation state outside the checkout on a new installation.
TOMATO_STATE=/absolute/private/path/tomato/state
