# Default deny: only the engineering sources and their offline tests are tracked.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/VERSION-CONTROL.md
!/HANDOFF-agents-git-20261002.md
!/concafe-act-validate.sh
!/CONCAFE-ACT.Dockerfile
!/docs/
/docs/*
!/docs/README.md
!/docs/history/
/docs/history/*
!/docs/history/HANDOFF-agents-git-20261002.md
!/tools/
/tools/*
!/tools/ci/
!/agents/
/agents/*
!/agents/team/
# Tomato is an intentional source submodule with its existing Git history.
!/agents/team/roles/tomato/skill/
!/tests/
!/scripts/
!/config/
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/.gitmodules
!/apps/
/apps/*
!/apps/orbit/
!/docs/package/

# Runtime evidence, local verification output, and backups never enter history.
**/state/
**/.state
**/.state.*
**/log/
**/logs/
**/*.log
**/verification/
**/*bak*
**/*backup*
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/node_modules/
**/.venv/

# Credentials and machine-local configuration, including linked config files.
**/.env
**/.env.*
**/*.token
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/secrets
**/secrets/**
**/.codex/
**/.claude/
**/credentials*
**/auth.json

# Examples are source; actual per-machine configuration stays private.
!**/.env.example
**/.git/
**/dist/
**/artifacts/
**/test-results/

/config/*
!/config/*.example
